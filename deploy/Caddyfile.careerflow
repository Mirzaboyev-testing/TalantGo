
# Careerup (/root/careerflow). Only these blocks were added; nothing else in this shared file is ours.
careerup.uz {
	encode gzip zstd
	reverse_proxy careerflow-web:8000
}

www.careerup.uz {
	redir https://careerup.uz{uri} permanent
}

# the address used before the domain (2026-10 … 2026-11-23): pages move to careerup.uz for good (old links,
# bookmarks, shared CVs); API and the bot webhook keep answering here for tabs still open on the old address
careerflow.2-28-27-205.sslip.io {
	encode gzip zstd
	@keep path /api/* /telegram/*
	handle @keep {
		reverse_proxy careerflow-web:8000
	}
	handle {
		redir https://careerup.uz{uri} permanent
	}
}
